# WhatsApp Extension Configuration

# WhatsApp Business API Credentials
# Get these from Meta for Developers (https://developers.facebook.com/)
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook Verification Token
# Set this to any secure random string, then use the same value in Meta webhook config
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# Single-Tenant Setup (optional)
# For single-tenant deployments, set this to your tenant/client ID
TENANT_ID=my-company

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Multiple WhatsApp Numbers (Multi-Tenant)
# Format: WHATSAPP_TOKEN_{TENANT_NAME}
WHATSAPP_TOKEN_RESTAURANT=token_for_restaurant_client
WHATSAPP_TOKEN_ECOMMERCE=token_for_ecommerce_client

# Logging
LOG_LEVEL=info
