# ============================================================================
# RUSKINS PLATFORM CLIENT - Environment Configuration
# ============================================================================
# 
# ONE codebase, MANY deployments. Configure via env vars!
#
# Example: Ecommerce Client
#   TENANT_ID=acme-store
#   ENABLE_ECOMMERCE=true
#   ENABLE_HOTEL=false
#
# Example: Hotel Client
#   TENANT_ID=grand-palace-hotel
#   ENABLE_ECOMMERCE=false
#   ENABLE_HOTEL=true
# ============================================================================

# ==== TENANT IDENTITY (REQUIRED) ====
TENANT_ID=my-company
# Or use DEFAULT_TENANT_ID for backwards compatibility
# DEFAULT_TENANT_ID=my-company

# ==== FEATURE FLAGS ====
# Enable/disable features for this deployment
ENABLE_CHAT=true           # Always true (core feature)
ENABLE_VOICE=true          # ElevenLabs voice chat
ENABLE_KNOWLEDGE_BASE=true # KB admin panel
ENABLE_ADMIN=true          # Admin dashboard

# Business modules (enable what you need)
ENABLE_ECOMMERCE=false     # Product catalog, cart, orders
ENABLE_HOTEL=false         # Room booking, reservations
ENABLE_PAYMENTS=false      # M-Pesa, card payments
ENABLE_WHATSAPP=false      # WhatsApp Business integration

# ==== PERSONA (Optional) ====
PERSONA_TONE=friendly      # friendly | professional | neutral
PERSONA_VERBOSITY=medium   # low | medium | high

# ==== CORS (Optional) ====
# Comma-separated list of allowed origins
CORS_ORIGINS=https://mysite.com,https://admin.mysite.com

# ==== ELEVENLABS (REQUIRED for voice/chat) ====
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=xi-xxxx-your-key-here
ELEVENLABS_AGENT_ID=agent_xxxx_your_agent_here

# Agent display settings
ELEVENLABS_AGENT_NAME=Customer Support
ELEVENLABS_AGENT_DESCRIPTION=AI-powered assistant

# Backend selection: mock (testing) | elevenlabs (production)
VOICE_BACKEND=elevenlabs

# ==== JWT SECRET (REQUIRED for production) ====
JWT_SECRET=change-this-to-a-random-secret-in-production

# ==== ECOMMERCE API (REQUIRED if ENABLE_ECOMMERCE=true) ====
# Your client's ecommerce site internal API
COMMERCE_API_URL=https://your-ecommerce-site.railway.app/api/internal
COMMERCE_API_KEY=your-internal-api-key-here
COMMERCE_CURRENCY=KES

# ==== PAYMENTS (Optional - if ENABLE_PAYMENTS=true) ====
PAYMENTS_BACKEND=mock      # mock | mpesa

# M-Pesa credentials (get from developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback
MPESA_ENV=sandbox          # sandbox | production
