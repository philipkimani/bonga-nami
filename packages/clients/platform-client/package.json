{
  "name": "@platform/client",
  "version": "1.0.0",
  "description": "Bonga Nami platform client — universal deployment with env-based feature flags",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -b && npm run build:widget",
    "build:widget": "vite build --config vite.widget.config.ts",
    "build:tsc": "tsc -b",
    "db:setup": "npx prisma db push --accept-data-loss=false",
    "db:studio": "npx prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pwsh -File test/test-tools-e2e.ps1"
  },
  "dependencies": {
    "@elevenlabs/react": "~0.2.0",
    "@platform/core": "workspace:*",
    "@platform/knowledge-base": "workspace:*",
    "@platform/payments-extension": "workspace:*",
    "@platform/voice-extension": "workspace:*",
    "@platform/whatsapp-extension": "workspace:*",
    "@types/multer": "^2.0.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "redis": "^5.0.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "prisma": "^5.22.0",
    "terser": "^5.27.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.1.0",
    "vitest": "^2.1.8"
  }
}
